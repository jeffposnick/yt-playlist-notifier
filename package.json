{
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@preact/preset-vite": "^2.10.6",
		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-query-devtools": "^5.105.0",
		"@types/node": "^24.19.2",
		"@types/serviceworker": "^0.0.203",
		"@typescript/lib-dom": "npm:@types/web@^0.0.359",
		"@unplugin-pwa/vite": "^0.0.3",
		"@vite-pwa/workbox-swkit": "^8.0.13",
		"concurrently": "^10.0.6",
		"firebase-tools": "^15.34.2",
		"idb-keyval": "^6.2.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"parse-entities": "^4.0.1",
		"preact": "^11.1.0",
		"preact-router": "^4.1.2",
		"remove-filename-hash": "^0.0.8",
		"typescript": "~7.0.2",
		"vite": "^8.3.5"
	},
	"engines": {
		"node": "^24"
	},
	"name": "yt-playlist-notifier",
	"scripts": {
		"build": "vite build",
		"deploy": "npm run lint && npm run build && firebase deploy",
		"dev": "vite",
		"lint:oxlint": "oxlint",
		"lint:format": "oxfmt --check",
		"lint:tsc-main": "tsc --noEmit --project tsconfig.json",
		"lint:tsc-sw": "tsc --noEmit --project src/service-worker/tsconfig.json",
		"lint:tsc-tests": "tsc --noEmit --project tests/tsconfig.json",
		"lint": "concurrently --group npm:lint:*",
		"format": "oxfmt --write .",
		"serve": "firebase emulators:start --project=yt-playlist-notifier",
		"stage": "vite build --mode staging && npm run serve",
		"test": "playwright test"
	},
	"type": "module",
	"version": "0.0.0",
	"allowScripts": {
		"esbuild@0.18.20": true,
		"protobufjs@7.2.4": true,
		"protobufjs@7.6.6": true,
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true
	}
}
