{
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@preact/preset-vite": "^2.10.6",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-query-devtools": "^5.102.8",
		"@types/node": "^24.13.3",
		"@types/serviceworker": "~0.0.200",
		"@typescript/lib-dom": "npm:@types/web@~0.0.354",
		"@unplugin-pwa/vite": "^0.0.2",
		"@vite-pwa/workbox-swkit": "^8.0.13",
		"concurrently": "^10.0.5",
		"firebase-tools": "^15.29.0",
		"idb-keyval": "^6.2.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"parse-entities": "^4.0.1",
		"preact": "^10.17.1",
		"preact-router": "^4.1.2",
		"remove-filename-hash": "^0.0.8",
		"typescript": "~7.0.2",
		"vite": "^8.2.2"
	},
	"name": "yt-playlist-notifier",
	"scripts": {
		"build": "vite build",
		"deploy": "npm run lint && npm run build && firebase deploy",
		"dev": "vite",
		"lint:oxlint": "oxlint",
		"lint:format": "oxfmt --check",
		"lint:tsc-main": "tsc --noEmit --project tsconfig.json",
		"lint:tsc-sw": "tsc --noEmit --project src/service-worker/tsconfig.json",
		"lint:tsc-tests": "tsc --noEmit --project tests/tsconfig.json",
		"lint": "concurrently --group npm:lint:*",
		"format": "oxfmt --write .",
		"stage": "vite build --mode staging && firebase emulators:start --project=yt-playlist-notifier",
		"test": "playwright test"
	},
	"type": "module",
	"version": "0.0.0",
	"volta": {
		"node": "24.20.0"
	},
	"allowScripts": {
		"esbuild@0.18.20": true,
		"protobufjs@7.2.4": true,
		"protobufjs@7.6.6": true,
		"fsevents@2.3.2": true,
		"fsevents@2.3.3": true
	}
